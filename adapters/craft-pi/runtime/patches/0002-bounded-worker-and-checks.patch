+    let mut bad = report.clone(); bad.checks[1].reason_code = CheckReasonCode::PrerequisiteBlocked; bad.checks[1].return_to = CheckReturnTo::Lead; cases.push(bad);
+    let mut bad = report.clone(); bad.checks[1].disposition = CheckDisposition::Executed; bad.checks[1].reason_code = CheckReasonCode::Passed; bad.checks[1].return_to = CheckReturnTo::None; cases.push(bad);
