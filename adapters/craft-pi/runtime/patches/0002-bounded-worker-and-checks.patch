+#[derive(Debug, Clone, Copy)]
+enum Action { None, RemoveBaseline, BreakOutputPath, FixValue, OptionalThenFix, DriftContract, Cancel }
+#[derive(Debug)]
+struct ReturnRuntime { calls: Arc<Mutex<usize>>, action: Action }
+impl policy::PolicyRuntime for ReturnRuntime {
+    fn backend_id(&self) -> &str { "offline-rpc-fixture" }
+    fn permission_contract(&self) -> &str { "pi-rpc-bounded-v1" }
+    fn conversation(&self, policy: Arc<ExecutionPolicy>, _: CliSpec, stop: CancelToken) -> Result<Box<dyn Conversation>, ToolError> {
+        Ok(Box::new(ReturnConversation { policy, stop, calls: self.calls.clone(), action: self.action, pending: false }))
+    }
+}
+struct ReturnConversation { policy: Arc<ExecutionPolicy>, stop: CancelToken, calls: Arc<Mutex<usize>>, action: Action, pending: bool }
+impl Conversation for ReturnConversation {
+    fn send(&mut self, _: &str) {
+        let mut calls = self.calls.lock().unwrap(); *calls += 1;
+        match self.action {
+            Action::RemoveBaseline if *calls == 1 => std::fs::remove_file(&self.policy.baseline.artifacts[0].output.path).unwrap(),
+            Action::BreakOutputPath if *calls == 1 => std::fs::create_dir(self.policy.app_root.join("program.exe")).unwrap(),
+            Action::OptionalThenFix if *calls == 1 => std::fs::remove_file(&self.policy.baseline.artifacts[0].output.path).unwrap(),
+            Action::OptionalThenFix | Action::FixValue if *calls == 2 => std::fs::write(self.policy.app_root.join("value.txt"), b"correct\r\n").unwrap(),
+            Action::DriftContract if *calls == 1 => std::fs::write(&self.policy.identity.scope_ref.path, b"contract changed").unwrap(),
+            Action::Cancel => self.stop.cancel(),
+            _ => {},
+        }
+        self.pending = true;
+    }
+    fn poll(&mut self) -> Vec<AgentEvent> {
+        if !std::mem::take(&mut self.pending) { return vec![]; }
+        vec![AgentEvent::TurnDone { backend: "offline".into(), input_tokens: 0, output_tokens: 0, cost_usd: None, cost_is_estimate: false }]
+    }
+    fn answer_consent(&mut self, _: &str, _: bool) {}
+    fn stop(&mut self) {}
+    fn is_busy(&self) -> bool { self.pending }
+}
+struct DuplicateKind;
+impl TargetKind for DuplicateKind {
+    fn id(&self) -> &'static str { "app" }
+    fn words(&self) -> KindWords { kinds::AppKind.words() }
+    fn detect(&self, _: &DetectCx) -> Option<u32> { Some(100) }
+    fn default_stack(&self, _: &DetectCx) -> &'static str { "Rust" }
+    fn goal(&self) -> &'static str { "a fixture" }
+    fn checks(&self, ws: &Workspace) -> Vec<Box<dyn Check>> {
+        let mut checks = kinds::AppKind.checks(ws); checks.push(Box::new(kinds::BuildCheck)); checks
+    }
+}
+fn run(root: &Path, action: Action, duplicate: bool) -> (Workspace, AcceptedResearch, Vec<RunEvent>, usize) {
+    let (hub, ws, p) = fixture(root);
+    run_policy(hub, ws, p, action, duplicate)
+}
+fn run_policy(hub: AiHub, ws: Workspace, p: AcceptedResearch, action: Action, duplicate: bool) -> (Workspace, AcceptedResearch, Vec<RunEvent>, usize) {
+    let calls = Arc::new(Mutex::new(0)); let mut kinds = KindRegistry::built_in(); if duplicate { kinds.register(Arc::new(DuplicateKind)); }
+    let opts = RunOptions { policy: Some(Arc::new(p.clone())), policy_runtime: Some(Arc::new(ReturnRuntime { calls: calls.clone(), action })), kinds, max_rounds: 3, ..Default::default() };
+    let mut run = RebuildRun::start(&hub, Workspace::open(&ws.root).unwrap(), opts).unwrap();
+    assert!(run.wait_for_completion(Duration::from_secs(15)).unwrap());
+    assert!(!ws.app_dir().join(".craft-owner.lock").exists(), "worker exit releases cooperative lease");
+    let events = run.poll(); let count = *calls.lock().unwrap(); (ws, p, events, count)
+}
+#[test]
+fn policy_required_returns_stop_after_one_builder_and_preserve_original_refs() {
+    for (action, duplicate, kind, route) in [(Action::RemoveBaseline, false, CheckReturnKind::NeedsEvidence, CheckReturnTo::OriginalPrimary),
+        (Action::BreakOutputPath, false, CheckReturnKind::Unsupported, CheckReturnTo::Lead),
+        (Action::None, true, CheckReturnKind::Unsupported, CheckReturnTo::Lead)] {
+        let root = tempfile::tempdir().unwrap(); let (ws, p, events, calls) = run(root.path(), action, duplicate);
+        assert_eq!(calls, 1, "required owner return must not send a second prompt");
+        assert!(events.iter().any(|e| matches!(e, RunEvent::Finished { ok: false, .. })));
+        let report = read_check_plan_report(&p, &ws.root, 1).unwrap();
+        let summary = report.return_summary("checks/round-1/accepted-check-plan.json".into()).unwrap();
+        assert_eq!(summary.kind, kind); assert_eq!(summary.return_to, route);
+        assert_eq!(summary.affected_tasks, p.identity.task_ids);
+        assert_eq!(summary.source_refs.case_ref, p.identity.case_ref);
+        assert_eq!(summary.source_refs.workitem_ref, p.identity.workitem_ref);
+        assert_eq!(summary.source_refs.acceptance_ref, p.identity.acceptance_ref);
+        assert_eq!(summary.source_refs.check_plan_ref, p.check_plan_ref);
+        let public = serde_json::to_value(&summary).unwrap();
+        assert!(!public.to_string().contains("diagnostic"));
+        assert!(public["records"].as_array().unwrap().iter().all(|r| r.get("reason").is_none()));
+        assert!(!ws.checks_dir().join("round-2").exists());
+    }
+    #[cfg(windows)] {
+    let root = tempfile::tempdir().unwrap(); let (hub, ws, mut p) = business_fixture(root.path(), false);
+    p.commands[0].command = "echo not-an-executable>program.exe".into();
+    let (ws, p, events, calls) = run_policy(hub, ws, p, Action::None, false);
+    assert_eq!(calls, 1, "unqualified process execution is not a code-refine retry");
+    assert!(events.iter().any(|e| matches!(e, RunEvent::Finished { ok: false, .. })));
+    let report = read_check_plan_report(&p, &ws.root, 1).unwrap();
+    assert_eq!(report.return_summary("report".into()).unwrap().kind, CheckReturnKind::ExecutionFailed);
+    let path = ws.checks_dir().join("round-1/accepted-check-plan.json");
+    let mut old: Value = serde_json::from_slice(&std::fs::read(&path).unwrap()).unwrap(); old["version"] = json!(1);
+    std::fs::write(&path, serde_json::to_vec(&old).unwrap()).unwrap();
