new file mode 100644
index 0000000000000000000000000000000000000000..7b40bb3518aee49ca950e24ff0db86f5b2c2a6b3
--- /dev/null
+++ b/crates/ai/src/rebuild/policy.rs
@@ -0,0 +1,58 @@
+//! Public integration seam for the separately owned Pi RPC adapter/driver.
+//! No fallback adapter is installed by this module.
+use super::*;
+pub use craft_anything_engine::execution_policy::{AcceptedResearch, ExecutionMode, ExecutionPolicy, ModelIdentity};
+
+/// The selected transport owns model verification, RPC completion and native-tool restriction.
+/// Implementations must use a dedicated `Engine::bounded_builder` for their MCP connection,
+/// verify actual model identity before every prompt, refuse native tools/agents and wait for
+/// driver/child exit. A capability declaration is admission metadata, not live verification.
+pub trait PolicyRuntime: Send + Sync + std::fmt::Debug {
+    fn backend_id(&self) -> &str;
+    fn permission_contract(&self) -> &str;
+    fn conversation(&self, policy: Arc<ExecutionPolicy>, spec: CliSpec, stop: CancelToken) -> Result<Box<dyn Conversation>, ToolError>;
+}
+
+pub(super) fn preflight(hub: &AiHub, ws: &Workspace, opts: &RunOptions) -> Result<Option<crate::BackendEntry>, ToolError> {
+    let Some(p) = &opts.policy else { return Ok(None) };
+    p.preflight(ws)?;
+    super::external_checks::validate_baselines(p)?;
+    let runtime = opts.policy_runtime.as_ref().ok_or_else(|| missing("A Pi RPC PolicyRuntime must be explicitly injected."))?;
+    let cfg = hub.config();
+    let entry = builder_backend(&cfg, opts.backend.as_deref().or_else(|| project_builder(&cfg, ws)))?;
+    if entry.config.kind != BackendKind::AgentCli || entry.config.ssh_host.is_some() || entry.options.acp == Some(true)
+        || !entry.options.args.is_empty() || runtime.backend_id() != p.model.backend_id
+        || runtime.permission_contract() != p.model.permission_contract {
+        return Err(missing("Only the selected local bounded Pi RPC runtime, without extra args or ACP, is supported."));
+    }
+    if opts.kinds.get(&p.kind_id).is_none() { return Err(missing("The frozen kind is not registered.")); }
+    let plugins = craft_anything_engine::wasm_plugins::checks(&hub.engine.session());
+    if plugins.iter().any(|c| c.kinds.is_empty() || c.kinds.iter().any(|k| k == &p.kind_id)) {
+        return Err(missing("Plugin checks have no reviewed identity in this first slice."));
+    }
+    if !opts.good_enough.is_finite() || !(0.0..=100.0).contains(&opts.good_enough) {
+        return Err(missing("The check threshold must be a finite percentage."));
+    }
+    if let Some(feedback) = p.refine_feedback()? {
+        if feedback.good_enough != opts.good_enough { return Err(missing("Refine feedback threshold differs from this run's frozen check threshold.")); }
+    }
+    Ok(Some(entry))
+}
+fn missing(message: &str) -> ToolError { craft_anything_engine::execution_policy::refusal("unsupported", message) }
+
+/// Exclusive file admission lock. A crash leaves a stale mark deliberately; no automatic takeover.
+/// This is a cooperative writer lease, not a filesystem ACL or process-tree cleanup receipt.
+pub(super) struct SourceLease { path: PathBuf, file: Option<std::fs::File> }
+impl SourceLease {
+    pub(super) fn acquire(p: &ExecutionPolicy) -> Result<Self, ToolError> {
+        let path = p.app_root.join(".craft-owner.lock");
+        let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(&path)
+            .map_err(|e| craft_anything_engine::execution_policy::refusal("owner-conflict", format!("Cannot acquire source writer lease: {e}")))?;
+        use std::io::Write;
+        if let Err(e) = file.write_all(p.owner_id.as_bytes()) { let _ = std::fs::remove_file(&path); return Err(ToolError::io(path.display(), e)); }
+        Ok(Self { path, file: Some(file) })
+    }
+}
+impl Drop for SourceLease {
+    fn drop(&mut self) { drop(self.file.take()); let _ = std::fs::remove_file(&self.path); }
+}
