+//! Controlled external baseline checks; no native Evidence import or original-program execution.
+use super::*;
+use craft_anything_engine::execution_policy::{BaselineKind, ExecutionPolicy, HashedRef, hash_file, read_capped, real, real_parent};
+use craft_anything_engine::workspace::Claim;
+use craft_anything_platform::process::Process;
+use serde::{Deserialize, Serialize};
+use std::collections::{BTreeMap, BTreeSet};
+mod build;
+mod plan;
+pub use build::BoundedBuildCheck;
+pub use plan::{CHECK_PLAN_REPORT_VERSION, CheckDisposition, CheckReasonCode, CheckReturnTo, CheckReturnKind, CheckSourceRefs, PlannedCheckRecord, CheckReturnItem, CheckReturnSummary, CheckPlanReport, read_check_plan_report};
+
+#[cfg(test)]
+pub(super) fn dependencies_ready(dependencies: &[String], results: &[CheckResult], threshold: f64) -> bool {
+    dependencies.iter().all(|id| results.iter().any(|result| &result.check == id && result.good(threshold)))
+}
+pub(super) fn result_disposition(result: &CheckResult, threshold: f64) -> CheckDisposition {
+    if result.good(threshold) { CheckDisposition::Executed } else { CheckDisposition::Failed }
+}
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct StateObservation {
+    pub relative_path: PathBuf,
+    pub sha256: Option<String>,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct SeedFile {
+    pub relative_path: PathBuf,
+    /// None explicitly means absent at the start. Some supplies immutable initial bytes.
+    pub content: Option<HashedRef>,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum ScenarioHarness {
+    #[serde(rename = "direct-exec-v1")]
+    DirectExecV1,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+pub enum ScenarioReset {
+    #[serde(rename = "fresh-copy-v1")]
+    FreshCopyV1,
+}
+/// v2 freezes the invocation harness, fresh-copy reset, initial seed and runtime file list.
+/// Every attempt starts in a new directory with a copy of the candidate executable and only
+/// explicitly listed runtime files. Existing app data is never reused as the initial oracle.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ExternalScenario {
+    pub version: u32,
+    pub task_id: String,
+    pub evidence_id: String,
+    pub harness: ScenarioHarness,
+    pub reset: ScenarioReset,
+    pub program: PathBuf,
+    pub runtime_files: Vec<PathBuf>,
+    pub seed_files: Vec<SeedFile>,
+    pub arguments: Vec<String>,
+    pub stdin: String,
+    pub environment: BTreeMap<String, String>,
+    pub timeout_secs: u64,
+    pub exit_code: i32,
+    pub stdout: String,
+    pub stderr: String,
+    pub state_files: Vec<StateObservation>,
+}
+fn relative(path: &Path) -> bool {
+    !path.as_os_str().is_empty() && !path.is_absolute()
+        && path.components().all(|c| matches!(c, std::path::Component::Normal(_)))
+}
+impl ExternalScenario {
+    fn validate(&self, p: &ExecutionPolicy, evidence: &str) -> Result<(), ToolError> {
+        let mut copied = BTreeSet::new();
+        let mut seeds = BTreeSet::new();
+        if self.version != 2 || !p.identity.task_ids.contains(&self.task_id) || self.evidence_id != evidence
+            || self.timeout_secs == 0 || self.timeout_secs > p.max_wall_secs || !relative(&self.program) {
+            return Err(invalid("Scenario must freeze version, task/evidence, own program and deadline."));
+        }
+        copied.insert(&self.program);
+        for path in &self.runtime_files {
+            if !relative(path) || !copied.insert(path) { return Err(invalid("Invalid or duplicate runtime file.")); }
+        }
+        for seed in &self.seed_files {
+            if !relative(&seed.relative_path) || copied.contains(&seed.relative_path) || !seeds.insert(&seed.relative_path) {
+                return Err(invalid("Seed files must be unique and separate from executable/runtime files."));
+            }
+            if let Some(content) = &seed.content {
+                let path = content.verify().map_err(|_| invalid("Immutable scenario seed is missing or changed."))?;
+                if path.starts_with(real_parent(&p.app_root)?) { return Err(invalid("Initial seeds must be immutable external references, not candidate app data.")); }
+            }
+        }
+        let mut states = BTreeSet::new();
+        for state in &self.state_files {
+            if !relative(&state.relative_path) || !states.insert(&state.relative_path) || !seeds.contains(&state.relative_path)
+                || state.sha256.as_ref().is_some_and(|h| h.len() != 64 || !h.bytes().all(|b| b.is_ascii_hexdigit() && !b.is_ascii_uppercase())) {
+                return Err(invalid("Every state observation requires a unique explicit initial seed/presence and lowercase expected hash."));
+            }
+        }
+        if self.state_files.is_empty() && self.stdout.is_empty() && self.stderr.is_empty() {
+            return Err(invalid("A scenario needs a nonempty observable stream or explicit state observation."));
+        }
+        Ok(())
+    }
+}
+fn invalid(message: &str) -> ToolError {
+    craft_anything_engine::execution_policy::refusal("needs-evidence", message)
+}
+fn scenario(p: &ExecutionPolicy, id: &str) -> Result<ExternalScenario, ToolError> {
+    let c = p.checks.iter().find(|c| c.id == id).ok_or_else(|| invalid("Check absent from plan."))?;
+    let key = c.baseline.as_deref().ok_or_else(|| invalid("Check has no baseline."))?;
+    let path = p.baseline.resolve(key, c.kind.ok_or_else(|| invalid("Check has no baseline kind."))?)
+        .map_err(|_| invalid("External scenario baseline is missing or changed."))?;
+    let bytes = read_capped(&path).map_err(|_| invalid("External scenario input cannot be read."))?;
+    let s: ExternalScenario = serde_json::from_slice(&bytes)
+        .map_err(|e| invalid(&format!("Unsupported external scenario format: {e}")))?;
+    let evidence = p.baseline.artifacts.iter().find(|a| a.key == key).map(|a| a.evidence_id.as_str()).ok_or_else(|| invalid("No provenance."))?;
+    s.validate(p, evidence)?;
+    Ok(s)
+}
+/// Read-only admission before creating a Workspace, lease or run directory. Reuses the
+/// engine's planned-input admission and the same semantic readers used by run preflight.
+/// Callers must match policy app_root/target/stack to their planned workspace; run start
+/// still performs full admission against the actual Workspace and selected runtime.
+pub fn validate_external_inputs(p: &ExecutionPolicy) -> Result<(), ToolError> {
+    p.preflight_inputs()?;
+    validate_baselines(p)
+}
+
+pub(super) fn validate_baselines(p: &ExecutionPolicy) -> Result<(), ToolError> {
+    for c in &p.checks {
+        match c.id.as_str() {
+            "app-screenshot" => {
+                let path = p.baseline.resolve(c.baseline.as_deref().unwrap_or_default(), BaselineKind::NativeScreenshot)?;
+                craft_anything_engine::tools::web_common::decode_png(&read_capped(&path)?)?;
+            }
+            "external-console" | "external-scenario" => { scenario(p, &c.id)?; }
+            _ => {}
+        }
+    }
+    Ok(())
+}
+
+pub struct ExternalConsoleCheck;
+pub struct ExternalScenarioCheck;
+impl kinds::Check for ExternalConsoleCheck {
+    fn id(&self) -> &'static str { "external-console" }
+    fn run(&self, cx: &mut kinds::CheckCx) -> Result<CheckResult, ToolError> { run_scenario(cx, self.id()) }
+}
+impl kinds::Check for ExternalScenarioCheck {
+    fn id(&self) -> &'static str { "external-scenario" }
+    fn run(&self, cx: &mut kinds::CheckCx) -> Result<CheckResult, ToolError> { run_scenario(cx, self.id()) }
+}
+
+/// Returns a newly created attempt root, after verifying all copied candidate and seed bytes.
+pub(super) fn prepare_scenario(s: &ExternalScenario, app: &Path, parent: &Path) -> Result<PathBuf, ToolError> {
+    static NEXT: AtomicU64 = AtomicU64::new(1);
+    let app = real(app)?;
+    std::fs::create_dir_all(parent).map_err(|e| ToolError::io(parent.display(), e))?;
+    let sandbox = parent.join(format!("scenario-{}-{}", craft_anything_engine::inbox::now_ms(), NEXT.fetch_add(1, Ordering::SeqCst)));
+    std::fs::create_dir(&sandbox).map_err(|e| ToolError::io(sandbox.display(), e))?;
+    let mut copied = Vec::new();
+    for relative in std::iter::once(&s.program).chain(s.runtime_files.iter()) {
+        let from = real(&app.join(relative))?;
+        if !from.starts_with(&app) { return Err(invalid("Scenario runtime file escapes app/.")); }
+        let digest = hash_file(&from)?;
+        let to = sandbox.join(relative);
+        if let Some(dir) = to.parent() { std::fs::create_dir_all(dir).map_err(|e| ToolError::io(dir.display(), e))?; }
+        std::fs::copy(&from, &to).map_err(|e| ToolError::io(to.display(), e))?;
+        if hash_file(&to)? != digest { return Err(invalid("Candidate runtime file changed during copy.")); }
+        copied.push(json!({"path": relative, "sha256": digest}));
+    }
+    for seed in &s.seed_files {
+        let to = sandbox.join(&seed.relative_path);
+        match &seed.content {
+            Some(reference) => {
+                let bytes = reference.read_verified()?;
+                if let Some(dir) = to.parent() { std::fs::create_dir_all(dir).map_err(|e| ToolError::io(dir.display(), e))?; }
+                std::fs::write(&to, bytes).map_err(|e| ToolError::io(to.display(), e))?;
+                if hash_file(&to)? != reference.sha256 { return Err(invalid("Scenario initial seed hash mismatch.")); }
+            }
+            None if to.exists() => return Err(invalid("Scenario initial absence is not satisfied.")),
+            None => {}
+        }
+    }
+    let receipt = serde_json::to_vec_pretty(&json!({"version":2,"harness":s.harness,"reset":s.reset,"runtime":copied,"seeds":s.seed_files}))
+        .map_err(|e| ToolError::internal(e.to_string()))?;
+    craft_anything_platform::fs::write_atomic_private(&sandbox.join("initial-seed-receipt.json"), &receipt)?;
+    Ok(sandbox)
+}
+pub(super) fn observe_state_files(root: &Path, states: &[StateObservation]) -> Result<Vec<Claim>, ToolError> {
+    let root = real(root)?;
+    let mut claims = Vec::new();
+    for state in states {
+        let path = real_parent(&root.join(&state.relative_path))?;
+        if !path.starts_with(&root) { return Err(invalid("Scenario state path escapes its fresh copy.")); }
+        let passed = match &state.sha256 { Some(expected) => hash_file(&path).is_ok_and(|h| h == *expected), None => !path.exists() };
+        claims.push(Claim::new(format!("State {}", state.relative_path.display()), passed, "state hash/presence differs"));
+    }
+    Ok(claims)
+}
+fn run_scenario(cx: &mut kinds::CheckCx, id: &str) -> Result<CheckResult, ToolError> {
+    let p = cx.execution_policy().ok_or_else(|| invalid("External checks require accepted research."))?;
+    let s = scenario(p, id)?;
+    let parent = cx.ws.checks_dir().join(format!("round-{}", cx.round));
+    if !real_parent(&parent)?.starts_with(real(&cx.ws.root)?) { return Err(invalid("Scenario output root escapes its workspace.")); }
+    let sandbox = prepare_scenario(&s, &cx.ws.app_dir(), &parent)?;
+    let program = sandbox.join(&s.program);
+    let cancel = cx.stop().clone();
+    let mut process = Process::new(&program).args(&s.arguments).cwd(&sandbox).env_clear().stdin_bytes(s.stdin.as_bytes())
+        .timeout(Duration::from_secs(s.timeout_secs)).stdout_cap(1024 * 1024).stderr_cap(1024 * 1024).cancel_when(move || cancel.is_cancelled());
+    for (key, value) in &s.environment { process = process.env(key, value); }
+    let out = process.run()?;
+    let mut claims = vec![Claim::new("Exact exit status", out.code == Some(s.exit_code), format!("expected {}, actual {:?}", s.exit_code, out.code)),
+        Claim::new("Exact ordered stdout", out.stdout_text() == s.stdout, "stdout differs"),
+        Claim::new("Exact ordered stderr", out.stderr_text() == s.stderr, "stderr differs")];
+    claims.extend(observe_state_files(&sandbox, &s.state_files)?);
+    let passed = claims.iter().all(|c| c.passed);
+    Ok(CheckResult { claims, ..CheckResult::new(id, cx.round, passed,
+        format!("Fresh-copy external scenario for task {} / evidence {}; seed receipt {}; exact status, streams and {} state observations. Raw observations do not close REA claims.",
+            s.task_id, s.evidence_id, sandbox.join("initial-seed-receipt.json").display(), s.state_files.len())) })
+}
diff --git a/crates/ai/src/rebuild/external_checks/build.rs b/crates/ai/src/rebuild/external_checks/build.rs
new file mode 100644
index 0000000000000000000000000000000000000000..552d718779eb61982cc0d8ed6eda3bd118915a63
--- /dev/null
+++ b/crates/ai/src/rebuild/external_checks/build.rs
@@ -0,0 +1,60 @@
+//! Explicit command-and-artifact build checks for accepted research. Never infer a toolchain.
+use super::*;
+use craft_anything_engine::execution_policy::source_digest_excluding;
+
+pub struct BoundedBuildCheck;
+impl kinds::Check for BoundedBuildCheck {
+    fn id(&self) -> &'static str { "build" }
+    fn run(&self, cx: &mut kinds::CheckCx) -> Result<CheckResult, ToolError> {
+        let p = cx.execution_policy().ok_or_else(|| invalid("Missing build policy."))?;
+        let build = p.build.as_ref().ok_or_else(|| invalid("unsupported: no explicit build invocation."))?;
+        let command = p.commands.get(build.command_index).ok_or_else(|| invalid("Missing frozen build command."))?;
+        let app = real(&cx.ws.app_dir())?;
+        if real(&command.cwd)? != app { return Err(invalid("Build cwd changed.")); }
+        // Validate the entire list before moving even the first output; a later forbidden
+        // entry must not partially preserve earlier files or displace the live owner lease.
+        for artifact in &build.artifacts { p.authorize_build_artifact(artifact)?; }
+        static NEXT: AtomicU64 = AtomicU64::new(1);
+        let parent = cx.ws.checks_dir().join(format!("round-{}", cx.round));
+        if !real_parent(&parent)?.starts_with(real(&cx.ws.root)?) { return Err(invalid("Build receipt root escapes the workspace.")); }
+        std::fs::create_dir_all(&parent).map_err(|e| ToolError::io(parent.display(), e))?;
+        let receipt_dir = parent.join(format!("build-{}-{}", craft_anything_engine::inbox::now_ms(), NEXT.fetch_add(1, Ordering::SeqCst)));
+        std::fs::create_dir(&receipt_dir).map_err(|e| ToolError::io(receipt_dir.display(), e))?;
+        let mut prior = Vec::new();
+        for (index, artifact) in build.artifacts.iter().enumerate() {
+            let path = p.authorize_build_artifact(artifact)?;
+            if path.exists() {
+                let digest = hash_file(&path)?;
+                let preserved = receipt_dir.join(format!("previous-artifact-{index}"));
+                // Hashing is I/O: recheck aliases/protected roots immediately before rename.
+                let path = p.authorize_build_artifact(artifact)?;
+                std::fs::rename(&path, &preserved).map_err(|e| ToolError::io(path.display(), e))?;
+                prior.push(json!({"path":artifact,"sha256":digest,"preserved":preserved}));
+            }
+        }
+        let source_before = source_digest_excluding(&app, &build.artifacts)?;
+        let cancel = cx.stop().clone();
+        let (shell, flags): (&str, &[&str]) = if cfg!(windows) { ("cmd", &["/D", "/C"]) } else { ("sh", &["-c"]) };
+        let out = Process::new(shell).args(flags).arg(&command.command).cwd(&app)
+            .timeout(Duration::from_secs(command.timeout_secs)).stdout_cap(1024 * 1024).stderr_cap(1024 * 1024)
+            .cancel_when(move || cancel.is_cancelled()).run()?;
+        let source_after = source_digest_excluding(&app, &build.artifacts)?;
+        let mut claims = vec![Claim::new("Frozen build command executed successfully", out.success, format!("exit status {:?}", out.code)),
+            Claim::new("Build inputs retained their source identity", source_before == source_after, "build changed non-output source files")];
+        let mut outputs = Vec::new();
+        for artifact in &build.artifacts {
+            let path = p.authorize_build_artifact(artifact)?;
+            let digest = hash_file(&path).ok();
+            let nonempty = std::fs::metadata(&path).is_ok_and(|m| m.is_file() && m.len() > 0);
+            claims.push(Claim::new(format!("Fresh build artifact {}", artifact.display()), nonempty && digest.is_some(), "expected output was not freshly produced"));
+            outputs.push(json!({"path":artifact,"sha256":digest,"nonempty":nonempty}));
+        }
+        let receipt = json!({"version":1,"implementation":"bounded-command-build-v1","command":command,
+            "source_before_sha256":source_before,"source_after_sha256":source_after,"prior_artifacts":prior,
+            "outputs":outputs,"exit_code":out.code,"stdout":out.stdout_text(),"stderr":out.stderr_text()});
+        let bytes = serde_json::to_vec_pretty(&receipt).map_err(|e| ToolError::internal(e.to_string()))?;
+        craft_anything_platform::fs::write_atomic_private(&receipt_dir.join("build-receipt.json"), &bytes)?;
+        let passed = claims.iter().all(|claim| claim.passed);
+        Ok(CheckResult { claims, ..CheckResult::new("build", cx.round, passed, format!("Explicit build command and source/artifact hashes recorded in {}.", receipt_dir.join("build-receipt.json").display())) })
+    }
+}
diff --git a/crates/ai/src/rebuild/external_checks/plan.rs b/crates/ai/src/rebuild/external_checks/plan.rs
new file mode 100644
index 0000000000000000000000000000000000000000..6023523cc4f7e8c25302409ffd5dd037de80270e
--- /dev/null
+++ b/crates/ai/src/rebuild/external_checks/plan.rs
@@ -0,0 +1,244 @@
+use super::*;
+
+/// Version 2 is required for typed routing; v1 files do not certify a return decision.
+pub const CHECK_PLAN_REPORT_VERSION: u32 = 2;
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum CheckDisposition { Executed, Failed, Skipped, Unsupported, NeedsEvidence, ExecutionError, Cancelled }
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum CheckReturnTo { None, ImplementationWorker, OriginalPrimary, SpecRunner, Lead }
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum CheckReasonCode {
+    Passed, ImplementationFailed, MissingEvidence, UnsupportedCapability, PermissionDenied,
+    InvalidInput, InputChanged, CheckExecutionError, NotApplicable, PrerequisiteBlocked,
+    PrerequisiteImplementationFailed, UnreviewedCheck, InvalidResult, UnverifiedResult, Cancelled,
+}
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum CheckReturnKind { NeedsEvidence, Unsupported, ImplementationFailed, ExecutionFailed, Cancelled }
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct CheckSourceRefs {
+    pub case_ref: HashedRef, pub scope_ref: HashedRef, pub workitem_ref: HashedRef,
+    pub feature_ref: HashedRef, pub acceptance_ref: HashedRef, pub bundle_ref: HashedRef,
+    pub check_plan_ref: HashedRef, pub baseline_refs: Vec<HashedRef>,
+    pub source_base_sha256: String,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct PlannedCheckRecord {
+    pub id: String, pub round: u32, pub required: bool, pub disposition: CheckDisposition,
+    pub return_to: CheckReturnTo, pub reason_code: CheckReasonCode,
+    /// Private diagnostic only. Public return summaries never include this text.
+    pub reason: String,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct CheckReturnItem {
+    pub id: String, pub round: u32, pub disposition: CheckDisposition,
+    pub return_to: CheckReturnTo, pub reason_code: CheckReasonCode,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct CheckReturnSummary {
+    pub version: u32, pub kind: CheckReturnKind, pub return_to: CheckReturnTo,
+    pub affected_tasks: Vec<String>, pub source_refs: CheckSourceRefs,
+    pub records_ref: PathBuf, pub records: Vec<CheckReturnItem>,
+}
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct CheckPlanReport {
+    pub version: u32, pub owner: String, pub round: u32, pub affected_tasks: Vec<String>,
+    pub source_refs: CheckSourceRefs, pub qualifications: Vec<Value>, pub checks: Vec<PlannedCheckRecord>,
+}
+impl PlannedCheckRecord {
+    fn valid_route(&self) -> bool {
+        use CheckDisposition as D; use CheckReturnTo as R; use CheckReasonCode as C;
+        matches!((self.disposition, self.return_to, self.reason_code),
+            (D::Executed, R::None, C::Passed) |
+            (D::Failed, R::ImplementationWorker, C::ImplementationFailed) |
+            (D::NeedsEvidence, R::OriginalPrimary, C::MissingEvidence) |
+            (D::Unsupported, R::Lead, C::UnsupportedCapability | C::PermissionDenied | C::UnreviewedCheck | C::InvalidResult | C::UnverifiedResult) |
+            (D::Unsupported, R::SpecRunner, C::InvalidInput | C::InputChanged) |
+            (D::ExecutionError, R::Lead, C::CheckExecutionError) |
+            (D::Cancelled, R::Lead, C::Cancelled) |
+            (D::Skipped, R::Lead, C::NotApplicable) |
+            (D::Skipped, R::ImplementationWorker, C::PrerequisiteImplementationFailed) |
+            (D::Skipped, R::OriginalPrimary | R::SpecRunner | R::Lead, C::PrerequisiteBlocked))
+    }
+}
+impl CheckPlanReport {
+    fn valid_shape(&self) -> bool {
+        let mut ids = BTreeSet::new();
+        self.version == CHECK_PLAN_REPORT_VERSION && self.round > 0 && !self.checks.is_empty()
+            && self.checks.iter().all(|c| c.round == self.round && ids.insert(&c.id) && c.valid_route())
+    }
+    /// Shared writer/reader validator. Routing tuples and dependency propagation are data
+    /// contracts, not trusted merely because this process normally writes the report.
+    pub fn validate(&self, policy: &ExecutionPolicy) -> Result<(), ToolError> {
+        if !self.valid_shape() || self.owner != policy.owner_id || self.affected_tasks != policy.identity.task_ids
+            || self.checks.len() != policy.checks.len()
+            || serde_json::to_value(&self.source_refs).ok() != serde_json::to_value(source_refs(policy)).ok() {
+            return Err(ToolError::invalid("Malformed typed check report."));
+        }
+        for (index, (record, plan)) in self.checks.iter().zip(&policy.checks).enumerate() {
+            if record.id != plan.id || record.required != plan.required { return Err(ToolError::invalid("Typed check report plan mismatch.")); }
+            let previous = self.checks.get(..index).ok_or_else(|| ToolError::invalid("Invalid check ordering."))?;
+            if plan.depends_on.iter().any(|id| !previous.iter().any(|r| &r.id == id)) { return Err(ToolError::invalid("Missing prior check dependency.")); }
+            let blocked = plan.depends_on.iter().find_map(|id| previous.iter().find(|r| &r.id == id && r.disposition != CheckDisposition::Executed));
+            match record.reason_code {
+                CheckReasonCode::PrerequisiteBlocked | CheckReasonCode::PrerequisiteImplementationFailed => {
+                    let dependency = blocked.ok_or_else(|| ToolError::invalid("Skipped check has no failed prerequisite."))?;
+                    let expected = if dependency.return_to == CheckReturnTo::ImplementationWorker { CheckReasonCode::PrerequisiteImplementationFailed } else { CheckReasonCode::PrerequisiteBlocked };
+                    if record.return_to != dependency.return_to || record.reason_code != expected { return Err(ToolError::invalid("Contradictory prerequisite return category.")); }
+                }
+                _ if blocked.is_some() && matches!(record.disposition, CheckDisposition::Executed | CheckDisposition::Failed)
+                    || blocked.is_some() && record.reason_code == CheckReasonCode::NotApplicable => return Err(ToolError::invalid("Check ran despite a blocked prerequisite.")),
+                _ => {},
+            }
+        }
+        Ok(())
+    }
+    /// Pure projection: stable codes and original references only, no diagnostic/provider text.
+    /// Returns required outcomes only. ImplementationFailed is refinable; all other returns
+    /// stop this batch. Optional unknowns stay in the private report without becoming passes.
+    pub fn return_summary(&self, records_ref: PathBuf) -> Option<CheckReturnSummary> {
+        if !self.valid_shape() {
+            return Some(CheckReturnSummary { version: CHECK_PLAN_REPORT_VERSION, kind: CheckReturnKind::ExecutionFailed,
+                return_to: CheckReturnTo::Lead, affected_tasks: self.affected_tasks.clone(), source_refs: self.source_refs.clone(), records_ref,
+                records: vec![CheckReturnItem { id: "check-report".into(), round: self.round, disposition: CheckDisposition::ExecutionError, return_to: CheckReturnTo::Lead, reason_code: CheckReasonCode::CheckExecutionError }] });
+        }
+        let blocked: Vec<_> = self.checks.iter().filter(|c| c.required && !matches!(c.return_to, CheckReturnTo::None | CheckReturnTo::ImplementationWorker)).collect();
+        let selected: Vec<_> = if blocked.is_empty() { self.checks.iter().filter(|c| c.required && c.return_to == CheckReturnTo::ImplementationWorker).collect() } else { blocked };
+        let first = selected.first()?;
+        let kind = match first.disposition {
+            _ if first.return_to == CheckReturnTo::ImplementationWorker => CheckReturnKind::ImplementationFailed,
+            CheckDisposition::NeedsEvidence => CheckReturnKind::NeedsEvidence,
+            CheckDisposition::Cancelled => CheckReturnKind::Cancelled,
+            CheckDisposition::ExecutionError => CheckReturnKind::ExecutionFailed,
+            _ if first.return_to == CheckReturnTo::OriginalPrimary => CheckReturnKind::NeedsEvidence,
+            _ => CheckReturnKind::Unsupported,
+        };
+        Some(CheckReturnSummary { version: CHECK_PLAN_REPORT_VERSION, kind, return_to: first.return_to,
+            affected_tasks: self.affected_tasks.clone(), source_refs: self.source_refs.clone(), records_ref,
+            records: selected.into_iter().map(|c| CheckReturnItem { id: c.id.clone(), round: c.round, disposition: c.disposition, return_to: c.return_to, reason_code: c.reason_code }).collect() })
+    }
+}
+/// Reads only the exact owner report for this round and binds its IDs/references to the policy.
+/// Older v1 diagnostics remain readable as JSON, but are not accepted as typed return metadata.
+pub fn read_check_plan_report(policy: &ExecutionPolicy, root: &Path, round: u32) -> Result<CheckPlanReport, ToolError> {
+    let path = root.join("checks").join(format!("round-{round}")).join("accepted-check-plan.json");
+    let report: CheckPlanReport = serde_json::from_slice(&read_capped(&path)?).map_err(|_| ToolError::invalid("Invalid typed check report."))?;
+    report.validate(policy)?;
+    if report.round != round { return Err(ToolError::invalid("Typed check report round mismatch.")); }
+    Ok(report)
+}
+fn source_refs(p: &ExecutionPolicy) -> CheckSourceRefs {
+    CheckSourceRefs { case_ref: p.identity.case_ref.clone(), scope_ref: p.identity.scope_ref.clone(), workitem_ref: p.identity.workitem_ref.clone(),
+        feature_ref: p.identity.feature_ref.clone(), acceptance_ref: p.identity.acceptance_ref.clone(), bundle_ref: p.original.bundle.clone(),
+        check_plan_ref: p.check_plan_ref.clone(), baseline_refs: p.baseline.artifacts.iter().flat_map(|a| [a.source.clone(), a.output.clone()]).collect(), source_base_sha256: p.source_base_sha256.clone() }
+}
+fn error_route(error: &ToolError) -> (CheckDisposition, CheckReturnTo, CheckReasonCode) {
+    use CheckDisposition as D; use CheckReturnTo as R; use CheckReasonCode as C;
+    // Only our stable contract reason codes qualify provenance/input failures. Never parse text.
+    match error.details.as_ref().and_then(|d| d.get("reason")).and_then(Value::as_str) {
+        // Cancellation always wins over any nested diagnostic details.
+        Some(_) if error.code == ErrorCode::Cancelled => return (D::Cancelled, R::Lead, C::Cancelled),
+        Some("needs-evidence" | "missing-input") => return (D::NeedsEvidence, R::OriginalPrimary, C::MissingEvidence),
+        Some("unsupported" | "tool-denied" | "path-denied" | "command-denied" | "effect-denied" | "model-policy") => return (D::Unsupported, R::Lead, C::UnsupportedCapability),
+        Some("identity-mismatch" | "source-drift" | "check-plan") => return (D::Unsupported, R::SpecRunner, C::InputChanged),
+        _ => {},
+    }
+    match error.code {
+        ErrorCode::Cancelled => (D::Cancelled, R::Lead, C::Cancelled),
+        ErrorCode::NoPermission | ErrorCode::ConsentRequired => (D::Unsupported, R::Lead, C::PermissionDenied),
+        ErrorCode::FeatureMissing | ErrorCode::NotSupported | ErrorCode::EngineMissing => (D::Unsupported, R::Lead, C::UnsupportedCapability),
+        ErrorCode::BadInput | ErrorCode::BadSettings => (D::Unsupported, R::SpecRunner, C::InvalidInput),
+        ErrorCode::FileChanged | ErrorCode::FileHashMismatch | ErrorCode::EvidenceHashMismatch | ErrorCode::StaleRevision => (D::Unsupported, R::SpecRunner, C::InputChanged),
+        // NotFound may mean a missing candidate executable; generic I/O is not original evidence.
+        _ => (D::ExecutionError, R::Lead, C::CheckExecutionError),
+    }
+}
+fn result_route(result: &CheckResult, threshold: f64) -> (CheckDisposition, CheckReturnTo, CheckReasonCode) {
+    if !result.unknowns.is_empty() { return (CheckDisposition::NeedsEvidence, CheckReturnTo::OriginalPrimary, CheckReasonCode::MissingEvidence); }
+    if result_disposition(result, threshold) == CheckDisposition::Failed { return (CheckDisposition::Failed, CheckReturnTo::ImplementationWorker, CheckReasonCode::ImplementationFailed); }
+    if result.claims.is_empty() && result.similarity.is_none() { return (CheckDisposition::Unsupported, CheckReturnTo::Lead, CheckReasonCode::UnverifiedResult); }
+    (CheckDisposition::Executed, CheckReturnTo::None, CheckReasonCode::Passed)
+}
+
+#[cfg(test)]
+mod policy_routing_tests {
+    use super::*;
+    #[test]
+    fn policy_error_codes_do_not_guess_evidence_from_io_or_diagnostic_text() {
+        for code in [ErrorCode::Internal, ErrorCode::FileError, ErrorCode::NotFound, ErrorCode::TimedOut, ErrorCode::ProgramFailed] {
+            let error = ToolError::new(code, "needs-evidence private provider/source body");
+            assert_eq!(error_route(&error), (CheckDisposition::ExecutionError, CheckReturnTo::Lead, CheckReasonCode::CheckExecutionError));
+        }
+        assert_eq!(error_route(&invalid("private missing evidence")), (CheckDisposition::NeedsEvidence, CheckReturnTo::OriginalPrimary, CheckReasonCode::MissingEvidence));
+        assert_eq!(error_route(&ToolError::new(ErrorCode::NoPermission, "private")), (CheckDisposition::Unsupported, CheckReturnTo::Lead, CheckReasonCode::PermissionDenied));
+        assert_eq!(error_route(&ToolError::new(ErrorCode::FileChanged, "private")), (CheckDisposition::Unsupported, CheckReturnTo::SpecRunner, CheckReasonCode::InputChanged));
+        assert_eq!(error_route(&ToolError::cancelled()), (CheckDisposition::Cancelled, CheckReturnTo::Lead, CheckReasonCode::Cancelled));
+    }
+    #[test]
+    fn policy_unknown_or_zero_claims_never_become_verified_and_optional_not_applicable_is_explicit() {
+        let mut result = CheckResult::new("x", 1, true, "private");
+        assert_eq!(result_route(&result, 90.0).2, CheckReasonCode::UnverifiedResult);
+        result.unknowns.push("unknown".into()); assert_eq!(result_route(&result, 90.0).0, CheckDisposition::NeedsEvidence);
+        let r = HashedRef { path: "private-reference".into(), sha256: "0".repeat(64) };
+        let refs = CheckSourceRefs { case_ref: r.clone(), scope_ref: r.clone(), workitem_ref: r.clone(), feature_ref: r.clone(), acceptance_ref: r.clone(), bundle_ref: r.clone(), check_plan_ref: r.clone(), baseline_refs: vec![r], source_base_sha256: "0".repeat(64) };
+        let record = PlannedCheckRecord { id: "optional".into(), round: 1, required: false, disposition: CheckDisposition::Skipped,
+            return_to: CheckReturnTo::Lead, reason_code: CheckReasonCode::NotApplicable, reason: "applies=false private diagnostic".into() };
+        let report = CheckPlanReport { version: CHECK_PLAN_REPORT_VERSION, owner: "test-owner".into(), round: 1, affected_tasks: vec!["T1".into()], source_refs: refs, qualifications: vec![], checks: vec![record] };
+        assert!(report.return_summary("report".into()).is_none());
+        assert_eq!(serde_json::to_value(&report).unwrap()["checks"][0]["reason_code"], "not-applicable");
+    }
+}
+
+impl Worker {
+    pub(in crate::rebuild) fn run_planned_checks(&self, ws: &Workspace, round: u32, cx: &mut kinds::CheckCx, merged: Vec<Box<dyn kinds::Check>>, admission_error: Option<ToolError>) -> Result<Vec<CheckResult>, ToolError> {
+        let Some(p) = &self.policy else { return Err(ToolError::invalid("Missing execution policy.")) };
+        let threshold = self.self_check.as_ref().map(|(_, threshold)| *threshold).ok_or_else(|| ToolError::invalid("Owner threshold missing."))?;
+        let mut records: Vec<PlannedCheckRecord> = Vec::new(); let mut results: Vec<CheckResult> = Vec::new();
+        for plan in &p.checks {
+            self.stop.check()?;
+            let count = merged.iter().filter(|c| c.id() == plan.id).count();
+            let dependency = plan.depends_on.iter().find_map(|id| records.iter().find(|r| &r.id == id && r.disposition != CheckDisposition::Executed));
+            let check: Box<dyn kinds::Check> = match plan.id.as_str() {
+                "build" => Box::new(BoundedBuildCheck), "app-screenshot" => Box::new(kinds::ScreenshotCheck),
+                "external-console" => Box::new(ExternalConsoleCheck), "external-scenario" => Box::new(ExternalScenarioCheck),
+                _ => return Err(ToolError::invalid("Unsupported planned check.")),
+            };
+            let input_error = p.revalidate_check_inputs(&plan.id).err();
+            let unavailable = if let Some(error) = &admission_error { Some((error_route(error), error.message.clone())) }
+                else if let Some(error) = &input_error { Some((error_route(error), error.message.clone())) }
+                else if count != 1 { Some(((CheckDisposition::Unsupported, CheckReturnTo::Lead, CheckReasonCode::UnreviewedCheck), "Check missing or duplicated after own/plugin merge.".into())) }
+                else if let Some(dependency) = dependency {
+                    let code = if dependency.return_to == CheckReturnTo::ImplementationWorker { CheckReasonCode::PrerequisiteImplementationFailed } else { CheckReasonCode::PrerequisiteBlocked };
+                    Some(((CheckDisposition::Skipped, dependency.return_to, code), "Prerequisite did not execute successfully.".into()))
+                } else if !check.applies(cx) { Some(((CheckDisposition::Skipped, CheckReturnTo::Lead, CheckReasonCode::NotApplicable), "applies=false; no observation executed.".into())) } else { None };
+            let (route, result, diagnostic) = if let Some((route, diagnostic)) = unavailable {
+                (route, CheckResult { unknowns: vec!["check-not-executed".into()], ..CheckResult::new(&plan.id, round, false, "Check not executed; see private plan report.") }, diagnostic)
+            } else {
+                match check.run(cx) {
+                    Ok(result) if result.check == plan.id && result.round == round => {
+                        let route = result_route(&result, threshold); let diagnostic = result.note.clone(); (route, result, diagnostic)
+                    }
+                    Ok(_) => ((CheckDisposition::Unsupported, CheckReturnTo::Lead, CheckReasonCode::InvalidResult), CheckResult::new(&plan.id, round, false, "Invalid check result."), "Check returned another identity/round.".into()),
+                    Err(e) if e.code == ErrorCode::Cancelled => return Err(e),
+                    Err(e) => {
+                        let route = error_route(&e);
+                        (route, CheckResult { unknowns: vec!["check-execution-unverified".into()], ..CheckResult::new(&plan.id, round, false, "Check could not execute; see private plan report.") }, e.message)
+                    }
+                }
+            };
+            records.push(PlannedCheckRecord { id: plan.id.clone(), round, required: plan.required, disposition: route.0, return_to: route.1, reason_code: route.2, reason: diagnostic });
+            results.push(result);
+        }
+        let dir = ws.checks_dir().join(format!("round-{round}"));
+        std::fs::create_dir_all(&dir).map_err(|e| ToolError::io(dir.display(), e))?;
+        let qualifications = p.baseline.artifacts.iter().map(|a| json!({"key":a.key,"origin_kind":a.origin_kind,"qualification":a.qualification(),"authority":a.authority,"losses":a.losses})).collect();
+        let report = CheckPlanReport { version: CHECK_PLAN_REPORT_VERSION, owner: p.owner_id.clone(), round, affected_tasks: p.identity.task_ids.clone(), source_refs: source_refs(p), qualifications, checks: records };
+        report.validate(p)?;
+        let bytes = serde_json::to_vec_pretty(&report).map_err(|e| ToolError::internal(e.to_string()))?;
+        craft_anything_platform::fs::write_atomic_private(&dir.join("accepted-check-plan.json"), &bytes)?;
+        Ok(results)
+    }
+}
