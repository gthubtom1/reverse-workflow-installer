+#[test]
+fn staged_read_references_are_admitted_only_when_actual_dispatch_can_read_them() {
+    let d = tempfile::tempdir().unwrap(); let (ws, mut p) = fixture(d.path());
+    p.read_references = vec![p.original.bundle.clone()]; assert!(p.preflight(&ws).is_err(), "outside-workspace read reference must fail admission");
+    std::fs::create_dir_all(ws.root.join("reference")).unwrap();
+    let staged = reference(&ws.root.join("reference/input.txt"), b"exact staged material");
+    p.read_references = vec![staged]; p.preflight(&ws).unwrap();
+    let mut session = crate::testing::session(); session.ext.insert(Arc::new(crate::inbox::InboxDir(ws.inbox_dir())));
+    let engine = Engine::bounded_builder(session, Arc::new(p));
+    let output = engine.call("build_file_read", json!({"path":"reference/input.txt"}), CallOptions::new(Caller::Mcp)).unwrap();
+    assert!(output.to_json().to_string().contains("exact staged material"));
+    assert!(engine.call("build_file_read", json!({"path":"reference/not-listed.txt"}), CallOptions::new(Caller::Mcp)).is_err());
+}
