+#[test]
+fn raw_observation_origin_preserves_qualification_and_refuses_fake_authority() {
+    let d = tempfile::tempdir().unwrap(); let (ws, mut p) = fixture(d.path());
+    p.baseline.artifacts[0].origin_kind = ExternalOrigin::Observation;
+    p.baseline.artifacts[0].authority = "raw-observation".into();
+    p.preflight(&ws).unwrap();
+    assert_eq!(p.baseline.artifacts[0].qualification(), ExternalQualification::RawObservationReaClaimsUnknown);
+    p.baseline.artifacts[0].authority = "accepted-native-claim".into(); assert!(p.preflight(&ws).is_err());
+    p.baseline.artifacts[0].authority = "raw-observation".into();
+    p.baseline.artifacts[0].evidence_id = format!("ev_{}", "0".repeat(64)); assert!(p.preflight(&ws).is_err());
+    let mut value = serde_json::to_value(&p.baseline.artifacts[0]).unwrap();
+    value["origin_kind"] = json!("native"); assert!(serde_json::from_value::<ExternalArtifact>(value.clone()).is_err());
+    value["origin_kind"] = json!("external/observation"); value["accepted_claim"] = json!(true);
+    assert!(serde_json::from_value::<ExternalArtifact>(value).is_err());
+    p.baseline.artifacts[0].evidence_id = "raw-record-1".into();
+    std::fs::write(&p.baseline.artifacts[0].output.path, b"corrupt baseline").unwrap();
+    assert!(p.preflight(&ws).is_err(), "raw origin never bypasses artifact hash checks");
+}
