+        failed_checks: vec![FailedRequiredCheck { id: "external-scenario".into(), task_ids: vec!["T1".into()], result: CheckResult::new("external-scenario", 1, false, "not saved") }] };
+    let path = d.path().join("feedback.json");
+    p.failed_feedback = Some(reference(&path, &serde_json::to_vec(&feedback).unwrap())); p.preflight(&ws).unwrap();
+    feedback.task_ids = vec!["other-task".into()]; p.failed_feedback = Some(reference(&path, &serde_json::to_vec(&feedback).unwrap())); assert!(p.preflight(&ws).is_err());
+    feedback.task_ids = vec!["T1".into()]; feedback.source_base_sha256 = "0".repeat(64); p.failed_feedback = Some(reference(&path, &serde_json::to_vec(&feedback).unwrap())); assert!(p.preflight(&ws).is_err());
+    feedback.source_base_sha256 = p.source_base_sha256.clone(); feedback.failed_checks[0].result.passed = true;
+    p.failed_feedback = Some(reference(&path, &serde_json::to_vec(&feedback).unwrap())); assert!(p.preflight(&ws).is_err(), "a passing check cannot authorize refine-only");
+    feedback.failed_checks[0].result.passed = false;
+    std::fs::remove_file(ws.app_dir().join("main.rs")).unwrap(); p.source_base_sha256 = source_digest(&ws.app_dir()).unwrap(); feedback.source_base_sha256 = p.source_base_sha256.clone();
+    p.failed_feedback = Some(reference(&path, &serde_json::to_vec(&feedback).unwrap())); assert!(p.preflight(&ws).is_err(), "empty implementation cannot refine");
+}
