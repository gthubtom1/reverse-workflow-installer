+#[test]
+fn effects_and_path_real_targets_are_capabilities() {
+    let d = tempfile::tempdir().unwrap(); let (ws, p) = fixture(d.path());
+    assert!(p.authorize("build_file_read", &json!({"path":"app/main.rs"}), Effects::READ_ONLY | Effects::ACCESSES_NETWORK).is_err());
+    assert!(p.authorize("build_command_run", &json!({"command":"cargo test --offline", "timeout_secs":21}), Effects::LAUNCHES_PROCESS).is_err());
+    assert!(p.authorize("build_command_run", &json!({"command":"cargo test --offline", "timeout_secs":20}), Effects::LAUNCHES_PROCESS).is_ok());
+    #[cfg(unix)] {
+        std::os::unix::fs::symlink(d.path(), ws.app_dir().join("escape")).unwrap();
+        assert!(p.authorize_path("app/escape/accepted.json", true, false).is_err());
+    }
+    assert!(p.authorize_path("app/.git/config", true, false).is_err());
+    assert!(p.authorize_path("app/a/../../accepted.json", true, false).is_err());
+    let _ = ws;
+}
