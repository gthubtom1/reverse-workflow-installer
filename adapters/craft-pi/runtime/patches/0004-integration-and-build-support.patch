+++ b/policy-build-job.py
@@ -0,0 +1,42 @@
+"""Local bounded verification job. Does not change host configuration."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parent
+STATUS = ROOT / "policy-build-status.json"
+
+
+def run():
+    env = os.environ.copy()
+    env["PATH"] = os.environ["POLICY_GNU_TOOL_DIR"] + ";" + env["PATH"]
+    env["CARGO_TARGET_DIR"] = str(ROOT / "target/policy-worker")
+    env["CARGO_TARGET_X86_64_PC_WINDOWS_GNU_LINKER"] = str(Path(os.environ["POLICY_GNU_TOOL_DIR"]) / "gcc.exe")
+    env["CARGO_HTTP_TIMEOUT"] = "20"
+    env["CARGO_NET_RETRY"] = "1"
+    args = ["cargo", "+stable-x86_64-pc-windows-gnu"] + sys.argv[2:]
+    tag = sys.argv[1]
+    status = {"state": "running", "pid": os.getpid(), "command": args, "started": time.time(), "timeout_seconds": 600}
+    STATUS.write_text(json.dumps(status, indent=2), encoding="utf-8")
+    with (ROOT / (tag + ".stdout.log")).open("wb") as out, (ROOT / (tag + ".stderr.log")).open("wb") as err:
+        try:
+            child = subprocess.Popen(args, cwd=ROOT, env=env, stdin=subprocess.DEVNULL, stdout=out, stderr=err)
+            status["cargo_pid"] = child.pid
+            STATUS.write_text(json.dumps(status, indent=2), encoding="utf-8")
+            result = child.wait(timeout=600)
+            status.update(state="finished", exit_code=result)
+        except subprocess.TimeoutExpired:
+            subprocess.run(["taskkill", "/PID", str(child.pid), "/T", "/F"], stdout=out, stderr=err, timeout=15)
+            child.wait(timeout=15)
+            status.update(state="timed-out", exit_code=None)
+        except Exception as exc:
+            status.update(state="failed-to-start", error=str(exc))
+    status["ended"] = time.time()
+    STATUS.write_text(json.dumps(status, indent=2), encoding="utf-8")
+
+
+if __name__ == "__main__":
+    run()
diff --git a/policy-export-patches.py b/policy-export-patches.py
new file mode 100644
index 0000000000000000000000000000000000000000..2b9f0c1d49997a2394e1cf8f198a3a41e1974b8a
--- /dev/null
+++ b/policy-export-patches.py
@@ -0,0 +1,83 @@
+"""Export ordered local source patches, without changing the index or creating a commit."""
+from hashlib import sha256
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parent
+BASE = "0326b4de8051f85a0f3139cd82f88f76911e6a35"
+OUT = ROOT / "patches/bounded-accepted-research"
+
+
+def git(*args, accepted=(0,)):
+    result = subprocess.run(["git", *args], cwd=ROOT, stdin=subprocess.DEVNULL,
+                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
+    if result.returncode not in accepted:
+        raise RuntimeError(result.stderr.decode("utf-8", errors="replace"))
+    return result.stdout
+
+
+def main():
+    if git("rev-parse", "HEAD").decode().strip() != BASE:
+        raise RuntimeError("Export requires the exact admitted upstream HEAD")
+    tracked = set(git("diff", "--name-only", "-z", "HEAD").decode().strip("\0").split("\0")) - {""}
+    untracked = set(git("ls-files", "--others", "--exclude-standard", "-z").decode().strip("\0").split("\0")) - {""}
+    excluded = {p for p in untracked if p.endswith(".log") or p == "policy-build-status.json" or p.startswith("patches/")}
+    sources = sorted(tracked | (untracked - excluded))
+    if any(not p.endswith((".rs", ".md", ".py", "Cargo.toml", "Cargo.lock")) for p in sources):
+        raise RuntimeError("Unexpected non-source file; inspect it before exporting")
+    if "Cargo.lock" in sources:
+        raise RuntimeError("This slice must not change the upstream dependency lock")
+    groups = [
+        ("0001-engine-contract-and-dispatch.patch", [p for p in sources if p.startswith("crates/engine/")]),
+        ("0002-bounded-worker-and-checks.patch", [p for p in sources if p.startswith("crates/ai/")]),
+        ("0003-bounded-mcp-exposure.patch", [p for p in sources if p.startswith("crates/mcp/")]),
+        ("0004-integration-and-build-support.patch", [p for p in sources if not p.startswith("crates/")]),
+    ]
+    if set(p for _, paths in groups for p in paths) != set(sources):
+        raise RuntimeError("Source group coverage differs")
+    OUT.mkdir(parents=True, exist_ok=True)
+    inventory = []
+    for p in sources:
+        data = (ROOT / p).read_bytes()
+        inventory.append({"path": p, "state": "modified" if p in tracked else "added",
+                          "sha256": sha256(data).hexdigest(), "bytes": len(data)})
+    patches = []
+    for name, paths in groups:
+        current_tracked = sorted(set(paths) & tracked)
+        data = git("diff", "--binary", "--full-index", "HEAD", "--", *current_tracked) if current_tracked else b""
+        for p in sorted(set(paths) - tracked):
+            data += git("diff", "--no-index", "--binary", "--full-index", "--", "/dev/null", p, accepted=(1,))
+        (OUT / name).write_bytes(data)
+        patches.append({"file": name, "sha256": sha256(data).hexdigest(), "bytes": len(data), "sources": paths})
+    identity = {"version": 1, "upstream": "https://github.com/storytold/craft-anything.git", "base_commit": BASE,
+                "base_tree": git("rev-parse", "HEAD^{tree}").decode().strip(),
+                "lock_sha256": sha256((ROOT / "Cargo.lock").read_bytes()).hexdigest(),
+                "upstream_lock_sha256": sha256(git("show", "HEAD:Cargo.lock")).hexdigest(),
+                "series": patches, "source_inventory": inventory,
+                "excluded_local_artifacts": sorted(excluded),
+                "notes": ["No commits or real-index writes", "Generated patches/manifests and build logs are not recursively included", "Apply in listed order to the exact base; source inventory hashes refer to local bytes"]}
+    if "--verify-replay" in sys.argv:
+        replay_name = sys.argv[sys.argv.index("--replay-name") + 1] if "--replay-name" in sys.argv else "policy-patch-replay"
+        if Path(replay_name).name != replay_name or replay_name in (".", ".."):
+            raise RuntimeError("Replay name must be one local directory name")
+        replay = ROOT / "target" / replay_name
+        if replay.exists():
+            raise RuntimeError("Replay root already exists; preserve it and choose an explicit new verification root")
+        git("worktree", "add", "--detach", str(replay), BASE)
+        for patch in patches:
+            path = str(OUT / patch["file"])
+            git("-C", str(replay), "apply", "--check", path)
+            git("-C", str(replay), "apply", path)
+        mismatches = [entry["path"] for entry in inventory
+                      if sha256((replay / entry["path"]).read_bytes()).hexdigest() != entry["sha256"]]
+        if mismatches:
+            raise RuntimeError("Replayed source bytes differ: " + repr(mismatches))
+        identity["replay"] = {"base": BASE, "root": str(replay), "check_and_apply": "passed", "matching_source_files": len(inventory)}
+    (OUT / "series.json").write_text(json.dumps(identity, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({"patches": len(patches), "sources": len(sources), "series": str(OUT / "series.json")}))
+
+
+if __name__ == "__main__":
+    main()
