+++ b/crates/mcp/src/bounded_policy_tests.rs
@@ -0,0 +1,33 @@
+//! Dispatch/exposure tests deliberately use unreadable references: denied calls must fail
+//! before trying to read any accepted material or discovering another toolset.
+use super::*;
+use craft_anything_engine::execution_policy::*;
+fn bounded() -> Server {
+    let r = json!({"path":"unreadable-test-reference", "sha256":"0".repeat(64)});
+    let policy: AcceptedResearch = serde_json::from_value(json!({
+        "version":1,"mode":"buildcheck",
+        "identity":{"case_ref":r,"scope_ref":r,"workitem_ref":r,"feature_ref":r,"acceptance_ref":r,"task_ids":["T1"]},
+        "original":{"target":{"kind":"none"},"target_identity":"test","bundle":r,"traceability":r,"scenarios":r,"qualifications":r,"environment":r},
+        "baseline":{"version":1,"root":"test-baseline","bundle_sha256":"0".repeat(64),"artifacts":[]},
+        "check_plan_ref":r,"checks":[],"source_base_sha256":"0".repeat(64),"app_root":"test-app","writable_roots":[],"read_references":[],"commands":[],"protected_paths":[],
+        "kind_id":"app","stack":"Rust","model":{"allowed":false,"expected":{"provider":"test","model":"test","effort":"high"},"backend_id":"test","permission_contract":"pi-rpc-bounded-v1"},
+        "owner_id":"test-owner","max_wall_secs":1,"failed_feedback":null
+    })).unwrap();
+    let engine = Arc::new(Engine::bounded_builder(craft_anything_engine::testing::session(), Arc::new(policy)));
+    Server::new(engine, ServerOptions::default(), Box::new(Vec::<u8>::new()))
+}
+#[test]
+fn bounded_builder_lists_only_build_tools_and_refuses_meta_resources_and_research_calls() {
+    let server = bounded();
+    let list = server.tools_list();
+    let names: BTreeSet<&str> = list["tools"].as_array().unwrap().iter().map(|s| s["name"].as_str().unwrap()).collect();
+    assert_eq!(names, BUILDER_TOOLS.iter().copied().collect());
+    for method in ["resources/read", "resources/list", "prompts/get", "prompts/list", "completion/complete"] {
+        assert!(server.handle_request(method, &json!({})).is_err(), "{method}");
+    }
+    for name in ["list_toolsets", "enable_toolset", "rebuild_start", "core_target_open", "mcp__craft__core_target_open", "codemode"] {
+        let response = server.tools_call(&json!(1), &json!({"name":name,"arguments":{"toolset":"all"}}), &CancelToken::default());
+        assert_eq!(response.pointer("/result/isError"), Some(&json!(true)), "{name}: {response}");
+        assert!(response.to_string().contains("tool-denied"));
+    }
+}
