{
  "schema_version": 1,
  "rea": {
    "repository": "https://github.com/morluto/rea",
    "package": "rea-agents",
    "metadata": "https://registry.npmjs.org/rea-agents/latest",
    "policy": "latest-stable",
    "install": "npm install --prefix <isolated-prefix> rea-agents@<version>"
  },
  "spec_kit": {
    "repository": "https://github.com/github/spec-kit",
    "package": "specify-cli",
    "metadata": "https://pypi.org/pypi/specify-cli/json",
    "policy": "latest-stable-non-yanked",
    "install": "uv tool install specify-cli==<version>"
  },
  "reverse": {
    "repository": "https://github.com/gthubtom1/reverse-skill",
    "api": "https://api.github.com/repos/gthubtom1/reverse-skill",
    "policy": "latest-release-or-main-resolved-commit"
  },
  "shell_guard": {
    "repository": "https://github.com/gthubtom1/agent-plugins",
    "api": "https://api.github.com/repos/gthubtom1/agent-plugins",
    "policy": "frozen-release-commit",
    "release_ref": "shell-guard-v0.3.0",
    "commit": "ac5d92ec1a448ddb390049b40878bc1489c5dfb2",
    "plugin_dir": "plugins/pi/shell-guard",
    "package_name": "@toti/pi-shell-guard",
    "version": "0.3.0",
    "expected_extension": "./index.ts",
    "required_files": ["package.json", "index.ts", "runtime.mjs", "src/config.mjs", "src/everything.mjs", "src/paths.mjs", "src/policy.mjs", "src/readonly.mjs", "src/split.mjs", "src/rules/interactive.mjs", "src/rules/rm.mjs", "src/rules/search.mjs", "src/rules/timeout.mjs", "src/rules/scripts.mjs", "src/wrappers.mjs", "src/trash.mjs", "src/vendor/unbash/arithmetic.js", "src/vendor/unbash/chars.js", "src/vendor/unbash/lexer.js", "src/vendor/unbash/parser.js", "src/vendor/unbash/parts.js", "src/vendor/unbash/word.js", "src/vendor/unbash/LICENSE"]
  }
}
